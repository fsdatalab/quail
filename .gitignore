__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
.DS_Store
.venv/
# raw torch-profiler pulls (127 MB each); the Modal volume holds them,
# and plots/make_figures.py skips the timeline figure when they are absent
results/engine/torchprof_*rank0.pt.trace.json.gz
logs/
results/logs/
# teed run logs are local artifacts; the result JSONs carry the numbers
quail/results/*.log
# exploration scratch and bulk outputs stay out of git
exploration/tmp/
exploration/output/
exploration/results/*.log
exploration/results/engine/torchprof_*
old_exploration/tmp/
old_exploration/output/
old_exploration/results/engine/torchprof_*

# generated benchmark corpora are rebuilt from seeds, never versioned
quail/results/quailb_data/
# process ID files and profiler traces are local artifacts
quail/results/*.pid
quail/results/torchprof_*.json.gz
