index 00000000..001460a5
--- /dev/null
+++ b/flash_attn/cute/inkling_bias.py
@@ -0,0 +1,68 @@
+# Copyright (c) 2026, Quail authors. BSD 3-Clause, as the rest of this package.
+"""Inkling 2's relative attention bias in the SM100 forward kernel.
+
+Every score gets rel[q, head] . proj[:, q - k], zero past EXTENT
+distances. A pre-pass writes each 128-row query tile's bias over its
+near keys, row-aligned, to a global scratch of MAX_TILES key tiles per
+query tile: row (first_tile[seq] + m_block) * KV_HEADS + kv_head in
+units of 128 rows, key tile n at column tile n - n_near. The load warp
+copies a near key tile's bias with TMA into its query stage's
+shared-memory slot, and the softmax warps add it as they scale S.
+"""
+
+import cutlass
+import cutlass.cute as cute
+from cutlass import Float32, Int32, const_expr
+from cutlass.cute.nvgpu import cpasync
+from quack import copy_utils
+
+EXTENT = 1024
+MAX_TILES = 10
+
+
+@cute.jit
+def tile_geometry(m_block, n_block, seqlen, first_tile, kv_head,
+                  M_BLOCK: cutlass.Constexpr, N_BLOCK: cutlass.Constexpr,
+                  GROUP: cutlass.Constexpr, KV_HEADS: cutlass.Constexpr):
+    """(whether the tile has bias, scratch row tile, scratch column tile)."""
+    first_row = m_block * M_BLOCK
+    shift = seqlen.seqlen_k - seqlen.seqlen_q
+    qmin = first_row // GROUP + shift
+    qmax = cutlass.min((first_row + M_BLOCK - 1) // GROUP,
+                       seqlen.seqlen_q - 1) + shift
+    n_near = cutlass.max(qmin - (EXTENT - 1), 0) // N_BLOCK
+    near = ((first_row < seqlen.seqlen_q * GROUP) & (n_block >= n_near)
+            & (n_block * N_BLOCK <= qmax))
+    row_tile = (first_tile + m_block) * KV_HEADS + kv_head
+    return near, row_tile, n_block - n_near
+
+
+@cute.jit
+def issue_tile(tma_atom, mBias, sBias_stage, pipe, slot, count, row_tile,
+               col_tile, M_BLOCK: cutlass.Constexpr, N_BLOCK: cutlass.Constexpr,
+               SLOTS: cutlass.Constexpr):
+    """TMA one bias tile into a stage's slot; count is the slot's uses."""
+    state = cutlass.pipeline.PipelineState(SLOTS, count, Int32(slot),
+                                           (count & 1) ^ 1)
+    gBias = cute.local_tile(mBias, (M_BLOCK, N_BLOCK), (row_tile, col_tile))
+    tBsB, tBgB = cpasync.tma_partition(
+        tma_atom, 0, cute.make_layout(1), cute.group_modes(sBias_stage, 0, 2),
+        cute.group_modes(gBias, 0, 2))
+    pipe.producer_acquire(state)
+    cute.copy(tma_atom, tBgB, tBsB, tma_bar_ptr=pipe.producer_get_barrier(state))
+
+
+@cute.jit
+def add_tile(tSrS, thr_mma_qk, thr_tmem_load, sBias_stage, pipe, slot, count,
+             scale, SLOTS: cutlass.Constexpr):
+    """Wait for a stage's bias tile, add the thread's row, release it."""
+    state = cutlass.pipeline.PipelineState(SLOTS, count, Int32(slot), count & 1)
+    tSsB = thr_mma_qk.get_slice(0).partition_C(sBias_stage)[(None, None), 0, 0]
+    tSsB_t2r = copy_utils.partition_D_position_independent(thr_tmem_load, tSsB)
+    bias = cute.make_rmem_tensor(tSsB_t2r.shape, cutlass.BFloat16)
+    pipe.consumer_wait(state)
+    cute.autovec_copy(tSsB_t2r, bias)
+    for i in cutlass.range_constexpr(cute.size(tSrS)):
+        tSrS[i] = tSrS[i] * scale + bias[i].to(Float32)
+    cute.arch.sync_warp()
+    pipe.consumer_release(state)
