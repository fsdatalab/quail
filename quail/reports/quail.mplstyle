axes.spines.top: False
axes.spines.right: False
axes.spines.left: True
axes.spines.bottom: True
axes.linewidth: 0.6
axes.edgecolor: 999999
axes.labelsize: 10
axes.labelcolor: 333333
axes.titlesize: 12
axes.titleweight: bold
axes.titlepad: 12
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.facecolor: white

grid.color: E0E0E0
grid.linewidth: 0.5
grid.linestyle: -
grid.alpha: 0.7

xtick.labelsize: 9
xtick.color: 555555
xtick.major.width: 0.5
xtick.major.size: 0
xtick.direction: out

ytick.labelsize: 9
ytick.color: 555555
ytick.major.width: 0.5
ytick.major.size: 0
ytick.direction: out

figure.dpi: 180
figure.facecolor: white
figure.autolayout: True

savefig.dpi: 180
savefig.bbox: tight
savefig.pad_inches: 0.2
savefig.facecolor: white

font.size: 10
font.family: sans-serif
font.sans-serif: Helvetica Neue, Helvetica, Arial, DejaVu Sans

text.color: 333333

lines.linewidth: 1.5
lines.markersize: 5

legend.frameon: False
legend.fontsize: 9
legend.labelcolor: 555555
